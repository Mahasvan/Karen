<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow plain-HTTP servers for OpenAI-compatible providers: Ollama, LM Studio, etc.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
