# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# LiteRT-LM tool calling dispatches via kotlin.reflect over KFunction. The ToolSet class
# and its @Tool-annotated methods must survive minification or the runtime cannot find them.
# See references/TOOL_CALLING_NOTES.md §3.
-keep class com.mahasvan.karen.provider.tensor.TensorAssistantBackend$AssistantToolSet { *; }
-keep @com.google.ai.edge.litertlm.Tool class * { *; }
-keepclassmembers class * {
    @com.google.ai.edge.litertlm.ToolParam *;
}

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}